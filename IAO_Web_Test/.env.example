# Local development config for this Express app.
NODE_ENV=development
PORT=3000
APP_NAME=Northgate

# Required, 32+ chars. Use a real secret value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your_32_characters_random_secret_here

DATABASE_PATH=./data/app.db
# Set true when running behind a reverse proxy so rate limits see real IPs
TRUST_PROXY=false

# --- Email (SMTP) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
MAIL_FROM="Northgate <noreply@example.com>"
